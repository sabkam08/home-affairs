{
  "AllowedHosts": "*",

  "Database": {
    "CommandTimeoutSeconds": 30
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },

  "OpenTelemetry": {
    "ServiceName": "HomeAffairs.Api"
  },

  "Jwt": {
    "Issuer": "HomeAffairs.Api",
    "Audience": "HomeAffairs.Client",
    "AccessTokenLifetimeMinutes": 15
  }
}
